menu "IO-Link Master Stack"

config IOL_MASTER
    bool "IO-Link Master stack support"
    depends on CCE4511_IOL_PL
    help
      Enables the IO-Link Master middleware
      with CCE4511 PHY IC.

if IOL_MASTER

config IOL_MASTER_NUM_CHIPS
    int "Number of CCE4511 chips"
    default 1
    range 1 4
    help
      Number of CCE4511 PHY chips driven by the stack. Each chip provides
      four IO-Link channels. Chip N is bound to the devicetree node with
      label "cce4511_N" (cce4511_0, cce4511_1, ...), which must carry its
      own SPI device and irq-gpios.

      Ports are assigned to chips in order: ports 1-4 -> cce4511_0,
      ports 5-8 -> cce4511_1, and so on.

config IOL_MASTER_NUM_CHANNELS
    int "Number of IO-Link channels (ports)"
    default 16 if IOL_MASTER_NUM_CHIPS = 4
    default 12 if IOL_MASTER_NUM_CHIPS = 3
    default 8  if IOL_MASTER_NUM_CHIPS = 2
    default 4
    range 1 16
    help
      Total number of IO-Link ports. Must not exceed 4 * IOL_MASTER_NUM_CHIPS.

config IOL_MASTER_STACK_SIZE
    int "IO-Link task stack size (bytes)"
    default 1024

config IOL_MASTER_TASK_PRIORITY
    int "IO-Link Master thread task priority"
    default 4

config IOL_DL_STACK_SIZE
    int "IO-Link DL task stack size (bytes)"
    default 1024

config IOL_DL_TASK_PRIORITY
    int "IO-Link DL thread task priority"
    default 5

config IOL_MASTER_LOG_LEVEL
    int "IO-Link Master log level"
    default 3
    range 0 4
    help
      Select the log level for the IO-Link Master module.
      0: None, 1: Error, 2: Warning, 3: Info, 4: Debug

module = IOL_MASTER
module-str = IO-Link Master
source "subsys/logging/Kconfig.template.log_config"

endif

endmenu